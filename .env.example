# このファイルをコピーして .env を作成してください:  cp .env.example .env
# .env は .gitignore 済み。本番の秘密情報は Secret Manager で管理する。

# ---------- backend ----------
# gemini | mock   （mock なら APIキー不要でフロー全体を動かせる）
DETECTOR_BACKEND=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Vertex AI 経由にする場合は true にし、GCP_PROJECT_ID / GCP_LOCATION を設定（APIキー不要・ADC認証）
GEMINI_USE_VERTEXAI=false
GCP_PROJECT_ID=
GCP_LOCATION=asia-northeast1

# アップロード上限（バイト）。Gemini インライン送信の上限に余裕を持たせる
MAX_UPLOAD_BYTES=15000000
# カンマ区切り。本番では Cloud Run の frontend URL のみに絞る
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---------- frontend ----------
# ブラウザに公開される値なので秘密情報を入れないこと
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

